# Ignore media and temporary buffers
*.ts
*.mp4
*.mkv
*.wav
*.mp3
*.srt

# Ignore binary executables
ffmpeg.exe
ffprobe.exe
*.exe

# Ignore clips output directory
clips/
clips/*

# Ignore python caches
__pycache__/
*.py[cod]
*$py.class
*.env
.venv/
env/
.idea/
.vscode/

# Ignore cloned repos and transcripts
repos/
transcript_*

# Ignore local YouTube OAuth tokens and secrets
client_secrets.json
youtube_credentials.json
